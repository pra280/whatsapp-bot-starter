
const { default: makeWASocket, useMultiFileAuthState, DisconnectReason } = require('@whiskeysockets/baileys');
const pino = require('pino');
const qrcode = require('qrcode-terminal');

async function startBot() {
  const { state, saveCreds } = await useMultiFileAuthState('./session');

  const sock = makeWASocket({
    auth: state,
    logger: pino({ level: 'silent' }),
    printQRInTerminal: false,
    browser: ['WhatsApp Bot Starter', 'Chrome', '1.0.0']
  });

  sock.ev.on('creds.update', saveCreds);

  sock.ev.on('connection.update', ({ connection, lastDisconnect, qr }) => {
    if (qr) qrcode.generate(qr, { small: true });

    if (connection === 'open') {
      console.log('WhatsApp Bot Starter berhasil terhubung!');
    }

    if (connection === 'close') {
      const statusCode = lastDisconnect?.error?.output?.statusCode;

      if (statusCode !== DisconnectReason.loggedOut) {
        startBot();
      } else {
        console.log('Sesi logout. Hubungkan ulang perangkat.');
      }
    }
  });

  sock.ev.on('messages.upsert', async ({ messages, type }) => {
    if (type !== 'notify') return;

    for (const msg of messages) {
      if (!msg.message || msg.key.fromMe) continue;

      const from = msg.key.remoteJid;
      if (!from || from === 'status@broadcast') continue;

      const text = (
        msg.message.conversation ||
        msg.message.extendedTextMessage?.text ||
        ''
      ).trim();

      if (!text.startsWith('.')) continue;

      const command = text.split(/\s+/)[0].toLowerCase();
      let reply = '';

      switch (command) {
        case '.menu':
          reply = [
            '🤖 *WHATSAPP BOT STARTER*',
            '',
            '📌 *Daftar perintah:*',
            '• .menu — Menampilkan menu',
            '• .ping — Mengecek respons bot',
            '• .info — Informasi bot'
          ].join('\n');
          break;

        case '.ping':
          reply = '🏓 Pong! Bot merespons dengan baik.';
          break;

        case '.info':
          reply = [
            'ℹ️ *WhatsApp Bot Starter*',
            'Versi: 1.0.0',
            'Library: Baileys',
            'Status: Aktif menerima pesan'
          ].join('\n');
          break;

        default:
          continue;
      }

      await sock.sendMessage(from, { text: reply }, { quoted: msg });
    }
  });
}

startBot().catch((err) => {
  console.error('Bot gagal dijalankan:', err);
});
